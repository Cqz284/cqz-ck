/* .page 骨架、.segment 分段控件、.act-btn、.edit-bar 已在 app.wxss 中统一定义 */

.page {
  /* 与记账编辑页统一使用 var(--space-page)（旧实现是 24rpx，两页差 8rpx） */
  padding: var(--space-page) 0 240rpx;
}

/* 选中态配色统一在 app.wxss（页面级选择器命中不了组件内部节点） */

/* 段控项带图标：图标与文字同一行居中，颜色继承选中态（主色 / 次要色） */
.segment__item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.segment__icon {
  margin-right: 8rpx;
}

/* 「纸面」感：行距放宽一点。最小高收紧（原 360rpx 把下半屏顶出大块空白），
   内容区跟着内容走，重心不再压在上半屏 */
.van-field__control {
  min-height: 220rpx;
  line-height: 1.7;
}

.van-field__word-limit {
  color: var(--sub-text-color) !important;
}

/* ===== 标签卡（笔记 / 待办通用） =====
   卡片口径与 due-card 一致（inset 卡对齐）；输入行复用 due-chip 做「添加」按钮 */
.tag-card {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card, 24rpx);
  box-shadow: var(--shadow-card);
}

.tag-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag-card__label {
  font-size: var(--font-sub, 24rpx);
  color: var(--sub-text-color);
}

.tag-card__count {
  font-size: var(--font-hint, 22rpx);
  color: var(--sub-text-color);
  font-variant-numeric: tabular-nums;
}

/* 标签区常驻：有标签渲染胶囊、没标签留一行淡占位（避免增删时布局上下跳） */
.tag-card__chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag-card__empty {
  font-size: var(--font-hint, 22rpx);
  color: var(--sub-text-color);
  opacity: 0.7;
}

.tag-chip {
  display: flex;
  align-items: center;
  padding: 6rpx 10rpx 6rpx 20rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--sub-bg, rgba(0, 0, 0, 0.04));
}

.tag-chip__text {
  font-size: var(--font-hint, 22rpx);
  color: var(--text-color);
}

/* × 的小热区：整圈可点，颜色继承（深浅色都随主题） */
.tag-chip__x {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-left: 6rpx;
  border-radius: 50%;
  color: var(--sub-text-color);
}

.tag-chip__x--hover {
  opacity: 0.7;
}

/* 输入行：输入框与「添加」按钮同行；覆盖内容输入区的最小高
   （那条规则按 class 命中本页所有 van-field，标签输入框只需要一行高） */
.tag-card__input {
  display: flex;
  align-items: center;
}

.tag-card__input .van-field {
  flex: 1;
  min-width: 0;
}

/* 内容输入区把本页所有 van-field 的输入框都撑到最小高，
   标签输入框是单行，得压回去 */
.tag-card .van-field__control {
  min-height: 0;
}

.tag-card__add {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 字数说明挪出 placeholder：与「0/10」（个数上限）分开，两个数字两个意思 */
.tag-card__hint {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-hint, 20rpx);
  color: var(--sub-text-color);
  opacity: 0.7;
}

/* ===== 截止时间卡（仅待办展开） =====
   常驻折叠容器：高度 + 透明度过渡，切「普通笔记/待办」不再硬跳
   （统计页 detail-wrap 同款：外层裁切 + 实测高度，内层不能带 margin） */
.due-wrap {
  height: 0;
  margin: 24rpx 32rpx 0;
  overflow: hidden;
  opacity: 0;
  transition: height 0.2s ease, opacity 0.2s ease;
}

.due-wrap--on {
  opacity: 1;
}

.due-card {
  padding: 28rpx 32rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card, 24rpx);
  box-shadow: var(--shadow-card);
}

.due-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.due-card__label {
  font-size: var(--font-hint, 22rpx);
  color: var(--sub-text-color);
}

.due-card__clear {
  font-size: var(--font-hint, 22rpx);
  color: var(--danger);
  padding: 4rpx 8rpx;
}

.due-card__clear--hover {
  opacity: 0.7;
}

.due-card__value {
  margin-top: 8rpx;
  font-size: var(--font-body, 28rpx);
  color: var(--text-color);
  font-variant-numeric: tabular-nums;
}

/* 未设置态降一级：小字灰色，不与已设时间同等视觉权重（用户不再误以为它是已选值） */
.due-card__value.is-empty {
  font-size: var(--font-hint, 22rpx);
  color: var(--sub-text-color);
}

.due-card__actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* picker 是原生组件，宽度会撑满剩余空间，收紧为内容宽 */
.due-card__picker {
  width: fit-content;
}

/* chip 两档语义：填充 = 直接设值（快捷项 / 添加），幽灵细线 = 打开选择器的动作项。
   填充档统一主题绿淡底（原来跟着 --accent 橙黄走，与全局绿色强调色像两个 App） */
.due-chip {
  padding: 10rpx 24rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--font-hint, 24rpx);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.due-chip--ghost {
  background: transparent;
  border: 1rpx solid var(--border-color);
  color: var(--text-color);
}

.due-chip--hover {
  transform: scale(0.96);
  opacity: 0.85;
}
