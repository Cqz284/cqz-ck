/* .page 骨架、.segment 分段控件、.act-btn、.row-divider 已在 app.wxss 中统一定义 */

/* 底部留出吸底操作条的高度（见 app.wxss 的 .edit-bar） */
.page {
  padding: var(--space-page) 0 240rpx;
}

/* 选中态配色（记账页用收支色强调，与记事页的中性选中态区分） */
.segment__item.is-on-expense { color: var(--danger); font-weight: 500; }
.segment__item.is-on-income { color: var(--primary); font-weight: 500; }

/* 点按反馈：滑块在下方平移时，被按住的文字给一点回弹
   ⚠️ 这条必须放 app.wxss（见那里同名选择器的注释）：写在页面里对 van-tabs 这类组件内部项不生效 */
.amount-box {
  margin: 0 var(--space-page) 24rpx;
  padding: var(--space-card);
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.amount-box__label {
  font-size: var(--font-hint);
  color: var(--sub-text-color);
}

.amount-box__row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.amount-box__symbol {
  font-size: var(--font-amount);
  font-weight: 500;
  margin-right: 12rpx;
}

.amount-box__input {
  flex: 1;
  display: block;
  box-sizing: border-box;
  /* 高度与金额字号同源，避免模板里再写一份 magic number */
  height: var(--font-amount-input);
  font-size: var(--font-amount-input);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  color: var(--text-color);
  line-height: 1.3;
}

.amount-box__ph {
  color: var(--sub-text-color);
  font-weight: 400;
}

/* ===== 循环标签条 =====
   交互：横向拖拽跟手（纵向让位给页面滚动）、松手惯性吸附、
   停在中线的标签自动选中并放大、点选弹性居中、"+"号新增、
   长按进入管理态可删除标签。
   几何与手势逻辑见 index.ts / utils/tag-strip.ts。 */
.tag-strip {
  position: relative;
  height: 88rpx;
  margin: 0 var(--space-page) 24rpx;
  overflow: hidden;
}

/* 几何测量完成前隐藏，避免首帧从左侧闪入 */
.tag-strip--pending {
  visibility: hidden;
}

/* 标签一屏放得下：降级为静态行，居中平铺（不做循环，避免同屏重复） */
.tag-strip--plain .tag-strip__track {
  justify-content: center;
}

.tag-strip__track {
  display: flex;
  align-items: center;
  height: 100%;
  will-change: transform;
}

.strip-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 76rpx;
  margin-right: 14rpx; /* JS 侧按实测值计算间距，此处只负责视觉 */
  padding: 12rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--card-bg);
  box-shadow: var(--shadow-card);
  font-size: var(--font-sub);
  color: var(--sub-text-color);
  white-space: nowrap;
  transition: transform 0.26s cubic-bezier(0.22, 1.32, 0.36, 1), background-color 0.18s ease,
    color 0.18s ease;
}

.strip-item__text {
  line-height: 1.2;
}

/* 选中：主色淡底 */
.strip-item--on {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 500;
}

/* 停在中线：轻微放大，形成"聚焦"感 */
.strip-item--focus {
  transform: scale(1.12);
  z-index: 3;
}

/* 加号（静态行内联形态）：实心圆形，与标签同高 */
.strip-item--plus {
  width: 58rpx;
  min-width: 58rpx;
  height: 58rpx;
  padding: 0;
  border-radius: 50%;
  background: var(--primary-soft);
  box-shadow: none;
  color: var(--primary);
  font-size: 36rpx;
  font-weight: 500;
}

/* 加号（循环模式钉在右端）：不随环转动，标签从其下方滑过。
   外圈用背景色光晕做视觉切割，滑近的标签会被"干净地"隔开。 */
.tag-strip__add {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 36rpx;
  font-weight: 500;
  box-shadow: 0 0 0 12rpx var(--bg-color);
  z-index: 4;
  transition: transform 0.16s cubic-bezier(0.22, 1.32, 0.36, 1), background-color 0.18s ease;
}

.tag-strip__add--hover {
  transform: translateY(-50%) scale(0.9);
  background: var(--primary);
  color: #fff;
}

/* 管理态：抖动提示可操作（iOS 风格） */
.strip-item--jiggle {
  animation: strip-jiggle 0.32s ease-in-out infinite alternate;
}

.strip-item--jiggle:nth-child(even) {
  animation-delay: 0.16s;
}

@keyframes strip-jiggle {
  from {
    transform: rotate(-1.8deg);
  }
  to {
    transform: rotate(1.8deg);
  }
}

/* 删除角标 */
.strip-item__del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 32rpx;
  border-radius: 50%;
  background: var(--danger);
  color: #fff;
  font-size: 26rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 两侧渐隐遮罩：提示内容可循环滑动，且不拦截触摸 */
.tag-strip__fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 64rpx;
  pointer-events: none;
}

.tag-strip__fade--l {
  left: 0;
  background: linear-gradient(90deg, var(--bg-color), rgba(0, 0, 0, 0));
}

.tag-strip__fade--r {
  right: 0;
  background: linear-gradient(270deg, var(--bg-color), rgba(0, 0, 0, 0));
}

/* ===== 标签管理条（长按标签后出现） ===== */
.tag-manage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -8rpx var(--space-page) 24rpx;
}

.tag-manage__hint {
  font-size: var(--font-hint);
  color: var(--sub-text-color);
}

.tag-manage__acts {
  display: flex;
  align-items: center;
}

.tag-manage__btn {
  margin-left: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill);
  background: var(--card-bg);
  font-size: var(--font-sub);
  color: var(--sub-text-color);
}

.tag-manage__btn--primary {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 500;
}

.tag-manage__btn--hover {
  opacity: 0.7;
}
