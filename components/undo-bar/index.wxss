.undo {
  position: fixed;
  left: var(--space-page, 32rpx);
  right: var(--space-page, 32rpx);
  bottom: 24rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-radius: var(--radius-control, 16rpx);
  background: var(--card-bg);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.16);
  /* 收起时整体滑出屏幕，并让出触摸，避免挡住列表 */
  transform: translateY(calc(100% + 40rpx));
  opacity: 0;
  pointer-events: none;
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.22s ease;
}

.undo--in {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.undo__text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body, 28rpx);
  color: var(--text-color);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.undo__btn {
  margin-left: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--font-sub, 24rpx);
  font-weight: 500;
  flex-shrink: 0;
}

.undo__btn--hover {
  opacity: 0.7;
}
