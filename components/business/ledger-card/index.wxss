/*
  间距约定：卡片自身**不带外边距**，左右页面留白与行间距统一由使用方的行容器提供
  （列表用 .card-row + .row-collapse，首页用 .card-row）。
  这样做是为了左滑删除：卡片若自带右外边距，滑开后卡片右缘必然比删除槽位靠里一截，
  中间就会露出一条缝。留白交给容器后，删除块与卡片天然严丝合缝。
*/
.card {
  display: flex;
  align-items: center;
  padding: 28rpx var(--space-card, 32rpx);
  background: var(--card-bg);
  border-radius: var(--radius-card, 24rpx);
  box-shadow: var(--shadow-card);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.card--hover {
  transform: scale(0.985);
  opacity: 0.92;
}

.card__badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card__badge--income {
  background: var(--primary-soft);
  color: var(--primary);
}

.card__badge--expense {
  background: var(--danger-soft);
  color: var(--danger);
}

.card__main {
  flex: 1;
  min-width: 0;
}

.card__title-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.card__tag {
  font-size: var(--font-body, 28rpx);
  color: var(--text-color);
}

.card__time {
  margin-left: 12rpx;
  font-size: var(--font-hint, 22rpx);
  color: var(--sub-text-color);
  flex-shrink: 0;
}

.card__remark {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-hint, 22rpx);
  color: var(--sub-text-color);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card__amount {
  font-size: 36rpx;
  margin-left: 24rpx;
  flex-shrink: 0;
}
