.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx var(--space-page, 32rpx);
}

/* 图标圈轻微上下浮动（2026-09-21 用户提议让空态更有温度）：
   幅度压得很小（6rpx）、周期偏慢（3s），是"呼吸感"不是"提醒感"；
   ease-in-out 往复在两个端点自然减速，循环衔接处不会顿挫。 */
@keyframes empty-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6rpx);
  }
}

.empty__icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  animation: empty-float 3s ease-in-out infinite;
}

.empty__text {
  font-size: var(--font-sub, 24rpx);
  color: var(--sub-text-color);
}

.empty__action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--primary);
  color: #fff;
  font-size: var(--font-sub, 24rpx);
}

.empty__action--hover {
  opacity: 0.88;
}
